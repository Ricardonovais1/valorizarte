# Copie este arquivo para .env.local e preencha os valores.
# .env.local nunca deve ser commitado — já está no .gitignore padrão do Next.js.

# --- Sanity (obtenha em manage.sanity.io depois de criar o projeto) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Os MESMOS três valores acima, repetidos com o prefixo SANITY_STUDIO_.
# Não é redundância à toa: o Next só injeta variáveis NEXT_PUBLIC_* no
# bundle do site, e o Vite (que compila o Studio) só injeta
# SANITY_STUDIO_* no bundle do Studio. Sem este par, `sanity deploy`
# publica um Studio que abre com o erro
# "Configuration must contain `projectId`".
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2025-01-01

# Token de escrita (Editor ou superior). Necessário para:
# - a rota de cadastro de newsletter gravar no Sanity
# - o script scripts/migrate-wp.ts
# Gere em manage.sanity.io -> seu projeto -> API -> Tokens -> Add API token
SANITY_API_WRITE_TOKEN=

# Segredo compartilhado com o webhook de revalidação (qualquer string
# aleatória forte, ex: gerada com `openssl rand -hex 32`)
SANITY_REVALIDATE_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://valorizarte.com.br

# --- Migração do WordPress (usado só por scripts/migrate-wp.ts) ---
WP_BASE_URL=https://valorizarte.com.br

# --- Brevo (e-mail de boas-vindas da newsletter) ---
# Crie uma conta gratuita em brevo.com (cobre até ~300 e-mails/dia, de
# sobra para o volume deste site) e gere a chave em:
# brevo.com -> Configurações -> Chaves SMTP e API -> Gerar uma nova chave API
# Sem esta chave, o cadastro na newsletter continua funcionando
# normalmente — só não dispara o e-mail de boas-vindas.
BREVO_API_KEY=
# E-mail remetente: precisa ser um endereço verificado na sua conta Brevo
# (Configurações -> Remetentes e IPs -> Remetentes).
BREVO_SENDER_EMAIL=contato@valorizarte.com.br
BREVO_SENDER_NAME=Valorizarte
