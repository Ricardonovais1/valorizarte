# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/
.dev.vars*
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts
worker-configuration.d.ts

# Claude Code — configuração local de permissões, específica da máquina
.claude/settings.local.json

# Material de apoio interno (PDFs, notas) — não faz parte do código,
# não precisa ir para o repositório.
/docs-internos/
